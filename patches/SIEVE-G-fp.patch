 //  is exactly SIEVE). The cache name is SieveG-<x> (e.g. SieveG-0.50).
 //  The ghost follows S3FIFO's fifo_ghost (S3FIFO.c).
 //
+//  ghost-type=fp (cache name SieveG-fp-<x>): a lean ghost. Instead of a FIFO of 8-byte ids (a
+//  cache_obj_t per entry in libCacheSim), it keeps 16-bit fingerprints (low 16 bits of the id's
+//  hash) in a ring buffer of x * cache size entries, and a count per fingerprint value (65,536
+//  values) for the membership test: 2 bytes per entry plus a fixed 256 KB. Different ids can share
+//  a fingerprint, so a returning id can be taken for a ghost hit by mistake; with many more
+//  entries than 65,536 fingerprint values, most fingerprints are present.
+//  A ghost hit consumes one occurrence of the fingerprint (live[fp]--); the ring slot it came from
+//  is not searched for but counted in pending[fp], and skipped when it leaves the ring.
+//
 
+#include "../../dataStructure/hash/hash.h"
 #include "../../dataStructure/hashtable/hashtable.h"
 #include "../../include/libCacheSim/evictionAlgo.h"
 
@@ -29,8 +39,18 @@ typedef struct {
   double ghost_ratio;
   int64_t n_ghost_hit;     // insertions whose id was in the ghost
   int64_t n_insert;        // all insertions
+
+  bool fp;                 // ghost-type=fp: fingerprint ghost instead of the FIFO
+  uint16_t *ring;          // fingerprints of evicted ids, oldest at ring_head
+  int64_t ring_cap, ring_head, ring_n;
+  uint32_t *live;          // per fingerprint: occurrences in the ring not yet consumed
+  uint32_t *pending;       // per fingerprint: consumed occurrences still in the ring
 } SieveG_params_t;
 
+static inline uint16_t SieveG_fp(obj_id_t id) {
+  return (uint16_t)(get_hash_value_int_64(&id) & 0xffff);
+}
+
 static const char *DEFAULT_PARAMS = "ghost-ratio=0.5";
 
