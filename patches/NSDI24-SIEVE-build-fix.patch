diff --git a/libCacheSim/scripts/install_dependency.sh b/libCacheSim/scripts/install_dependency.sh
index a155d74..573fd58 100644
--- a/libCacheSim/scripts/install_dependency.sh
+++ b/libCacheSim/scripts/install_dependency.sh
@@ -1,8 +1,19 @@
 #!/bin/bash 
 
+# number of parallel build jobs, override with JOBS=N
+# an unbounded `make -j` can run out of memory when compiling xgboost,
+# so default to one job per 2GB of available memory, capped at nproc
+MEM_GB=$(awk '/MemAvailable/ {print int($2/1024/1024)}' /proc/meminfo 2>/dev/null || echo 4)
+JOBS=${JOBS:-$(( MEM_GB / 2 > 0 ? MEM_GB / 2 : 1 ))}
+JOBS=$(( JOBS < $(nproc) ? JOBS : $(nproc) ))
+
 setup_ubuntu() {
 	sudo apt update
-	sudo apt install -yqq libglib2.0-dev libgoogle-perftools-dev build-essential cmake google-perftools xxhash
+	sudo apt install -yqq libglib2.0-dev libgoogle-perftools-dev build-essential cmake xxhash
+	# google-perftools (pprof cli) was dropped in newer Ubuntu releases, tcmalloc comes from libgoogle-perftools-dev
+	if apt-cache show google-perftools >/dev/null 2>&1; then
+		sudo apt install -yqq google-perftools
+	fi
 }
 
