+static cache_obj_t *LeCaR_sieve_candidate(LeCaR_params_t *params, bool mutate) {
+  cache_obj_t *pointer = params->sieve_pointer ? params->sieve_pointer
+                                                : params->q_tail;
+  cache_obj_t *origin = pointer;
+  while (pointer != NULL && pointer->LeCaR.evict_expert != 0) {
+    if (mutate) pointer->LeCaR.evict_expert = 0;
+    pointer = pointer->queue.prev;
+  }
+  if (pointer == NULL) {
+    pointer = params->q_tail;
+    while (pointer != NULL && pointer->LeCaR.evict_expert != 0) {
+      if (!mutate && pointer == origin) return pointer;
+      if (mutate) pointer->LeCaR.evict_expert = 0;
+      pointer = pointer->queue.prev;
+    }
+  }
+  // When every resident is visited, the mutating pass returns to its origin
+  // after clearing the full cycle. Preview must select that same object.
+  return pointer;
+}
