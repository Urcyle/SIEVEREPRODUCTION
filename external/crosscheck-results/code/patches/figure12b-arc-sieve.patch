+/* SIEVE over ARC's frequent-object T2 queue. ARC metadata occupies the
+ * cache object's union, so the independent visited bit uses misc.freq. */
+static cache_obj_t *_ARC_sieve_candidate(ARC_params_t *params) {
+  cache_obj_t *obj = params->T2_sieve_pointer != NULL
+                         ? params->T2_sieve_pointer
+                         : params->L2_data_tail;
+  if (obj == NULL) return NULL;
+  cache_obj_t *start = obj;
+  while (obj->misc.freq > 0) {
+    obj = obj->queue.prev != NULL ? obj->queue.prev : params->L2_data_tail;
+    if (obj == start) return start;
+  }
+  return obj;
+}
+
+static cache_obj_t *_ARC_sieve_evict(ARC_params_t *params) {
+  cache_obj_t *obj = params->T2_sieve_pointer != NULL
+                         ? params->T2_sieve_pointer
+                         : params->L2_data_tail;
+  if (obj == NULL) return NULL;
+  while (obj->misc.freq > 0) {
+    obj->misc.freq = 0;
+    obj = obj->queue.prev != NULL ? obj->queue.prev : params->L2_data_tail;
+  }
+  params->T2_sieve_pointer = obj->queue.prev;
+  return obj;
+}
