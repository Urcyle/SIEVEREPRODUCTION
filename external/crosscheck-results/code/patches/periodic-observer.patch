+  }
+
+  if (observer.enabled && req_cnt > observer.last_req) {
+    observer_emit(&observer, cache, "final", req_cnt, miss_cnt, true);
+  }
+  free(observer.hotset);
+  free(observer.next_hotset);
 
   double runtime = gettime() - start_time;
 
diff --git a/libCacheSim/libCacheSim/cache/eviction/Sieve.c b/libCacheSim/libCacheSim/cache/eviction/Sieve.c
--- a/libCacheSim/libCacheSim/cache/eviction/Sieve.c
+++ b/libCacheSim/libCacheSim/cache/eviction/Sieve.c
@@ -13,6 +13,21 @@
 
   cache_obj_t *pointer;
 } Sieve_params_t;
+
+/* Read-only observer: raw pointer rank from tail, or effective tail for NULL.
+ * An empty queue has no rank. This walk is called only at sample points. */
+int64_t Sieve_observer_hand_rank(const cache_t *cache, bool *pointer_null) {
+  const Sieve_params_t *params = cache->eviction_params;
+  *pointer_null = params->pointer == NULL;
+  if (params->q_tail == NULL) return -1;
+  if (*pointer_null) return 0;
+  int64_t rank = 0;
+  for (const cache_obj_t *obj = params->q_tail; obj != NULL; obj = obj->queue.prev) {
+    if (obj == params->pointer) return rank;
+    rank++;
+  }
+  return -1;
+}
 
